{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "enum": [
        "2026-10-28"
      ]
    },
    "observation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scope": {
      "type": "object",
      "properties": {
        "environment": {
          "enum": [
            "RESEARCH",
            "PAPER",
            "TESTNET",
            "LIVE"
          ]
        },
        "venue_account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "product": {
          "enum": [
            "SPOT",
            "USD_M_PERP",
            "US_EQUITY"
          ]
        },
        "instrument_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "venue_leg": {
          "enum": [
            "BOTH",
            "LONG",
            "SHORT"
          ]
        }
      },
      "required": [
        "environment",
        "venue_account_id",
        "product",
        "instrument_uid",
        "venue_leg"
      ],
      "additionalProperties": false
    },
    "venue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "namespace": {
      "enum": [
        "ORDINARY",
        "ORDER_LIST",
        "CONDITIONAL_ALGO",
        "EXECUTION_ALGO"
      ]
    },
    "parent_client_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "parent_venue_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "status": {
      "enum": [
        "ACTIVE",
        "SUBMIT_UNKNOWN",
        "CANCEL_PENDING",
        "CANCEL_UNKNOWN",
        "STOPPED",
        "COMPLETED"
      ]
    },
    "unallocated_quantity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "cumulative_quantity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "occurred_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "contract_version",
    "observation_id",
    "scope",
    "venue",
    "namespace",
    "parent_client_id",
    "parent_venue_id",
    "status",
    "unallocated_quantity",
    "cumulative_quantity",
    "occurred_at"
  ],
  "additionalProperties": false
}
