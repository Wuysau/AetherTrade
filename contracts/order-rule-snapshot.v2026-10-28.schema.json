{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "enum": [
        "2026-10-28"
      ]
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scope": {
      "type": "object",
      "properties": {
        "environment": {
          "enum": [
            "RESEARCH",
            "PAPER",
            "TESTNET",
            "LIVE"
          ]
        },
        "venue_account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "product": {
          "enum": [
            "SPOT",
            "USD_M_PERP",
            "US_EQUITY"
          ]
        },
        "instrument_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "venue_leg": {
          "enum": [
            "BOTH",
            "LONG",
            "SHORT"
          ]
        }
      },
      "required": [
        "environment",
        "venue_account_id",
        "product",
        "instrument_uid",
        "venue_leg"
      ],
      "additionalProperties": false
    },
    "venue": {
      "enum": [
        "BINANCE"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "tick_size": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "quantity_step": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "minimum_quantity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "minimum_notional": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "quote_asset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "base_asset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "allowed_tifs": {
      "type": "array",
      "items": {
        "enum": [
          "GTC",
          "IOC",
          "FOK",
          "GTX",
          "GTD",
          "DAY",
          "RPI"
        ]
      }
    },
    "maximum_callback_percent": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "hash": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "environment": {
            "enum": [
              "RESEARCH",
              "PAPER",
              "TESTNET",
              "LIVE"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "visible_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "id",
          "hash",
          "environment",
          "source",
          "visible_at"
        ],
        "additionalProperties": false
      }
    },
    "as_of": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "valid_until": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "contract_version",
    "snapshot_id",
    "scope",
    "venue",
    "revision",
    "tick_size",
    "quantity_step",
    "minimum_quantity",
    "minimum_notional",
    "quote_asset",
    "base_asset",
    "allowed_tifs",
    "maximum_callback_percent",
    "evidence",
    "as_of",
    "valid_until"
  ],
  "additionalProperties": false
}
