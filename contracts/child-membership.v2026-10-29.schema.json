{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "enum": [
        "2026-10-29"
      ]
    },
    "membership_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "authority_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "binding_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scope": {
      "type": "object",
      "properties": {
        "environment": {
          "enum": [
            "RESEARCH",
            "PAPER",
            "TESTNET",
            "LIVE"
          ]
        },
        "venue_account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "product": {
          "enum": [
            "SPOT",
            "USD_M_PERP",
            "US_EQUITY"
          ]
        },
        "instrument_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "venue_leg": {
          "enum": [
            "BOTH",
            "LONG",
            "SHORT"
          ]
        }
      },
      "required": [
        "environment",
        "venue_account_id",
        "product",
        "instrument_uid",
        "venue_leg"
      ],
      "additionalProperties": false
    },
    "venue": {
      "enum": [
        "BINANCE"
      ]
    },
    "parent_namespace": {
      "enum": [
        "ORDINARY",
        "ORDER_LIST",
        "CONDITIONAL_ALGO",
        "EXECUTION_ALGO"
      ]
    },
    "child_namespace": {
      "enum": [
        "ORDINARY"
      ]
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "group_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "child_order_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "child_client_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "enum": [
        "VENUE_GENERATED_CHILD",
        "APPLICATION_GENERATED_CHILD"
      ]
    },
    "command_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "command_hash": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "durable_record_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "source_evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "hash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "environment": {
          "enum": [
            "RESEARCH",
            "PAPER",
            "TESTNET",
            "LIVE"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "visible_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "id",
        "hash",
        "environment",
        "source",
        "visible_at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "membership_id",
    "authority_hash",
    "binding_hash",
    "scope",
    "venue",
    "parent_namespace",
    "child_namespace",
    "node_id",
    "group_id",
    "child_order_id",
    "child_client_id",
    "origin",
    "command_id",
    "command_hash",
    "durable_record_ref",
    "source_evidence"
  ],
  "additionalProperties": false
}
