{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "venue_client_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "service_namespace": {
      "enum": [
        "ORDINARY",
        "ORDER_LIST",
        "CONDITIONAL_ALGO",
        "EXECUTION_ALGO"
      ]
    },
    "owner_strategy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "contract_version": {
      "enum": [
        "2026-10-28"
      ]
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "program_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scope": {
      "type": "object",
      "properties": {
        "environment": {
          "enum": [
            "RESEARCH",
            "PAPER",
            "TESTNET",
            "LIVE"
          ]
        },
        "venue_account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "product": {
          "enum": [
            "SPOT",
            "USD_M_PERP",
            "US_EQUITY"
          ]
        },
        "instrument_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "venue_leg": {
          "enum": [
            "BOTH",
            "LONG",
            "SHORT"
          ]
        }
      },
      "required": [
        "environment",
        "venue_account_id",
        "product",
        "instrument_uid",
        "venue_leg"
      ],
      "additionalProperties": false
    },
    "origin": {
      "enum": [
        "APPLICATION_ACTION",
        "APPLICATION_GENERATED_CHILD"
      ]
    },
    "operation": {
      "enum": [
        "SUBMIT",
        "CANCEL",
        "AMEND",
        "SUBMIT_PROGRAM",
        "CANCEL_PROGRAM",
        "AMEND_PROGRAM",
        "SET_PROTECTION"
      ]
    },
    "parent_command_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "target_venue_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "canonical_program_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ownership_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "execution_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "policy_revision": {
      "type": "integer",
      "minimum": 0
    },
    "durable_record_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "state": {
      "enum": [
        "DURABLE_READY",
        "MAY_HAVE_SENT",
        "UNKNOWN",
        "VENUE_CONFIRMED",
        "VENUE_REJECTED",
        "ABORTED_UNSENT"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "venue_client_id",
    "service_namespace",
    "owner_strategy_id",
    "contract_version",
    "command_id",
    "program_id",
    "scope",
    "origin",
    "operation",
    "parent_command_id",
    "target_venue_id",
    "canonical_program_hash",
    "ownership_epoch",
    "execution_epoch",
    "policy_revision",
    "durable_record_ref",
    "state",
    "created_at"
  ],
  "additionalProperties": false
}
