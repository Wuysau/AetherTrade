{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RiskPolicy",
  "description": "Design contract; structure validation does not verify financial authorization or venue behavior.",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "2026-10-20"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "environment": {
      "enum": [
        "RESEARCH",
        "PAPER",
        "TESTNET",
        "LIVE"
      ]
    },
    "collateral_group_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "valuation_currency": {
      "type": "string",
      "pattern": "^[A-Z0-9]{2,16}$"
    },
    "maximum_capital": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$"
    },
    "cash_buffer": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "maximum_order_notional": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$"
    },
    "maximum_planned_loss_per_intent": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$"
    },
    "maximum_total_planned_loss": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$"
    },
    "maximum_gross_exposure": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$"
    },
    "maximum_net_exposure": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$"
    },
    "maximum_open_positions": {
      "type": "integer",
      "minimum": 1
    },
    "maximum_active_orders": {
      "type": "integer",
      "minimum": 1
    },
    "maximum_leverage": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "daily_loss_fraction": {
      "type": "string",
      "pattern": "^(?:0\\.[0-9]*[1-9][0-9]*|1(?:\\.0+)?)$"
    },
    "maximum_drawdown_fraction": {
      "type": "string",
      "pattern": "^(?:0\\.[0-9]*[1-9][0-9]*|1(?:\\.0+)?)$"
    },
    "risk_day_timezone": {
      "type": "string",
      "minLength": 3
    },
    "maximum_quote_age_ms": {
      "type": "integer",
      "minimum": 1
    },
    "maximum_entry_slippage_bps": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "maximum_model_cost_per_day": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,16}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "protection_policy": {
      "enum": [
        "NATIVE_REQUIRED",
        "HOSTED_ALLOWED_CASH_ONLY"
      ]
    },
    "daily_lock_release": {
      "enum": [
        "REVIEW_REQUIRED",
        "RECHECK_ON_NEW_RISK_DAY"
      ]
    },
    "drawdown_lock_release": {
      "const": "REVIEW_REQUIRED"
    },
    "native_risk_bypass": {
      "const": false
    },
    "live_enabled": {
      "type": "boolean"
    }
  },
  "required": [
    "contract_version",
    "policy_id",
    "revision",
    "environment",
    "collateral_group_id",
    "valuation_currency",
    "maximum_capital",
    "cash_buffer",
    "maximum_order_notional",
    "maximum_planned_loss_per_intent",
    "maximum_total_planned_loss",
    "maximum_gross_exposure",
    "maximum_net_exposure",
    "maximum_open_positions",
    "maximum_active_orders",
    "maximum_leverage",
    "daily_loss_fraction",
    "maximum_drawdown_fraction",
    "risk_day_timezone",
    "maximum_quote_age_ms",
    "maximum_entry_slippage_bps",
    "maximum_model_cost_per_day",
    "protection_policy",
    "daily_lock_release",
    "drawdown_lock_release",
    "native_risk_bypass",
    "live_enabled"
  ],
  "additionalProperties": false
}
