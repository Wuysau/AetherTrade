{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "enum": [
        "2026-10-29"
      ]
    },
    "record_kind": {
      "enum": [
        "PROGRAM_APPLICATION_WRITE"
      ]
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "intent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "program_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scope": {
      "type": "object",
      "properties": {
        "environment": {
          "enum": [
            "RESEARCH",
            "PAPER",
            "TESTNET",
            "LIVE"
          ]
        },
        "venue_account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "product": {
          "enum": [
            "SPOT",
            "USD_M_PERP",
            "US_EQUITY"
          ]
        },
        "instrument_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "venue_leg": {
          "enum": [
            "BOTH",
            "LONG",
            "SHORT"
          ]
        }
      },
      "required": [
        "environment",
        "venue_account_id",
        "product",
        "instrument_uid",
        "venue_leg"
      ],
      "additionalProperties": false
    },
    "origin": {
      "enum": [
        "APPLICATION_ACTION",
        "APPLICATION_GENERATED_CHILD"
      ]
    },
    "operation": {
      "enum": [
        "CREATE_REQUEST"
      ]
    },
    "service_namespace": {
      "enum": [
        "BINANCE_SPOT_ORDINARY",
        "BINANCE_SPOT_ORDER_LIST",
        "BINANCE_USD_M_ORDINARY",
        "BINANCE_USD_M_CONDITIONAL_ALGO",
        "BINANCE_SPOT_EXECUTION_ALGO",
        "BINANCE_USD_M_EXECUTION_ALGO",
        "BINANCE_REAL_EQUITY"
      ]
    },
    "parent_command_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "venue_client_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "owner_strategy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ownership_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "execution_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "policy_revision": {
      "type": "integer",
      "minimum": 0
    },
    "request_index": {
      "type": "integer",
      "minimum": 0
    },
    "canonical_program_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "compilation_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "allocation_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "intent_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "basis_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "decision_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "archive_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "request_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "binding_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "state": {
      "enum": [
        "DURABLE_READY",
        "MAY_HAVE_SENT",
        "UNKNOWN"
      ]
    },
    "durable_record_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "valid_until": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "contract_version",
    "record_kind",
    "command_id",
    "intent_id",
    "program_id",
    "scope",
    "origin",
    "operation",
    "service_namespace",
    "parent_command_id",
    "venue_client_id",
    "owner_strategy_id",
    "ownership_epoch",
    "execution_epoch",
    "policy_revision",
    "request_index",
    "canonical_program_hash",
    "compilation_hash",
    "allocation_hash",
    "intent_hash",
    "basis_hash",
    "decision_hash",
    "archive_hash",
    "request_hash",
    "binding_hash",
    "state",
    "durable_record_ref",
    "created_at",
    "valid_until"
  ],
  "additionalProperties": false
}
