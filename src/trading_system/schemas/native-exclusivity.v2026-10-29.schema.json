{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "enum": [
        "2026-10-29"
      ]
    },
    "group_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "authority_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "binding_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "membership_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scope": {
      "type": "object",
      "properties": {
        "environment": {
          "enum": [
            "RESEARCH",
            "PAPER",
            "TESTNET",
            "LIVE"
          ]
        },
        "venue_account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "product": {
          "enum": [
            "SPOT",
            "USD_M_PERP",
            "US_EQUITY"
          ]
        },
        "instrument_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "venue_leg": {
          "enum": [
            "BOTH",
            "LONG",
            "SHORT"
          ]
        }
      },
      "required": [
        "environment",
        "venue_account_id",
        "product",
        "instrument_uid",
        "venue_leg"
      ],
      "additionalProperties": false
    },
    "venue": {
      "enum": [
        "BINANCE"
      ]
    },
    "namespace": {
      "enum": [
        "ORDER_LIST"
      ]
    },
    "template": {
      "enum": [
        "OCO",
        "OTOCO",
        "OPOCO"
      ]
    },
    "node_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "guarantee": {
      "enum": [
        "ONE_EXECUTING_MEMBER"
      ]
    },
    "rule_revision": {
      "type": "integer",
      "minimum": 0
    },
    "rule_snapshot_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "adapter_build_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "hash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "environment": {
          "enum": [
            "RESEARCH",
            "PAPER",
            "TESTNET",
            "LIVE"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "visible_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "id",
        "hash",
        "environment",
        "source",
        "visible_at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "group_id",
    "authority_hash",
    "binding_hash",
    "membership_hash",
    "scope",
    "venue",
    "namespace",
    "template",
    "node_ids",
    "guarantee",
    "rule_revision",
    "rule_snapshot_hash",
    "adapter_build_digest",
    "source_evidence"
  ],
  "additionalProperties": false
}
