# Copy to .env.runtime or let scripts/start-console.ps1 generate local settings.
# Default portable mode persists data inside this worktree's ignored .runtime/.
# PostgreSQL mode uses a dedicated Compose database and never silently falls back.
# AETHERTRADE_DATABASE_URL=postgresql+psycopg://aethertrade:CHANGE_ME@127.0.0.1:55432/aethertrade
AETHERTRADE_HOST=127.0.0.1
AETHERTRADE_PORT=8787
AETHERTRADE_MARKET_ENABLED=true
AETHERTRADE_MARKET_POLL_SECONDS=15
AETHERTRADE_QUOTE_MAX_AGE_SECONDS=90
AETHERTRADE_SESSION_HOURS=12
AETHERTRADE_AUTOMATION_ENABLED=true
# Optional encrypted-model-key master file; default is .runtime/model-secrets.key.
# AETHERTRADE_MODEL_KEY_PATH=/absolute/private/path/model-secrets.key
