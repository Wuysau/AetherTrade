{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "aether-db": {
        "type": "remote",
        "url": "http://127.0.0.1:5000/mcp/aether-db",
        "oauth": false,
        "codemode": false,
        "timeout": {
          "startup": 45000,
          "catalog": 30000,
          "execution": 30000
        }
      }
    }
  }
}
